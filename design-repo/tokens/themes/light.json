{
  "id": "light",
  "mode": "light",
  "$description": "The only theme measured (the page as served). Every semantic token resolves to a real foundation value.",
  "resolves": {
    "surface.default": "rgb(255,255,255)",
    "surface.alt": "rgb(215,217,210)",
    "surface.inverse": "rgb(0,0,0)",
    "surface.accent": "rgb(92,6,50)",
    "text.primary": "rgb(104,110,96)",
    "text.secondary": "rgb(135,140,128)",
    "text.inverse": "rgb(255,255,255)",
    "text.accent": "rgb(92,6,50)",
    "border.default": "rgb(0,0,0)",
    "accent.primary": "rgb(92,6,50)",
    "typography.display": {
      "fontFamily": "Exposure",
      "fontSize": "60px",
      "fontWeight": "400",
      "lineHeight": "67.2px"
    },
    "typography.heading": {
      "fontFamily": "Open Runde",
      "fontSize": "22px",
      "fontWeight": "500",
      "lineHeight": "29.7px"
    },
    "typography.body": {
      "fontFamily": "Open Runde",
      "fontSize": "17px",
      "fontWeight": "400",
      "lineHeight": "30.6px"
    },
    "typography.label": {
      "fontFamily": "Open Runde",
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": "22.4px"
    },
    "radius.control": "22px",
    "radius.surface": "2px",
    "elevation.default": "rgb(255, 255, 255) 0px 0px 0px 4px",
    "motion.duration.default": "0.16s",
    "motion.easing.default": "ease"
  }
}
